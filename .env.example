# ============================================================
#  吃一点 · Eat A Bit 环境变量模板
#  使用方法：复制为 .env.local，填入真实值
#  cp .env.example .env.local
# ============================================================

# ---------- Supabase ----------
# 在 Supabase Dashboard → Project Settings → API 中获取
# 注意：NEXT_PUBLIC_ 开头的变量会暴露到浏览器端，这是正常的（anon key 本来就是公开的）

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---------- AI 识别（后期接入，MVP 阶段可以留空） ----------
# 多模态模型 API Key（比如 OpenAI / 通义千问 / 智谱等）
# 放在服务端使用，不要加 NEXT_PUBLIC_ 前缀
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
